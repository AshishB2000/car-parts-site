{
  "name": "car-parts-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Static reference site: every part of a car, what it does, and how it fails.",
  "scripts": {
    "build": "node --experimental-strip-types scripts/build-pages.mjs",
    "test": "node --experimental-strip-types --test \"scripts/lib/*.test.mjs\"",
    "sync:data": "node scripts/sync-data.mjs",
    "check:data": "node scripts/sync-data.mjs --check",
    "check:links": "node scripts/check-links.mjs",
    "build:stills": "node --experimental-strip-types scripts/build-stills.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
